import React, { useEffect, useState } from "react";
import {
  getDeliveryChallans,
  cancelDeliveryChallan,
  getDeliveryChallanPdf,
  getInvoiceByChallan
} from "../api/api";

export default function DeliveryChallanList({ onEdit }) {

  const [list, setList] = useState([]);
  const [filter, setFilter] = useState("ACTIVE");

  useEffect(() => {
    load();
  }, []);

  const load = async () => {
    const data = await getDeliveryChallans();
    setList(data || []);
  };

  const handleViewInvoice = async (id) => {
    const inv = await getInvoiceByChallan(id);

    if (!inv) {
      alert("Invoice not created yet");
      return;
    }

    window.open(`http://localhost:8080/api/invoices/${inv.id}/pdf`);
  };

  const filtered = list.filter(
    (c) => filter === "ALL" || c.status === filter
  );

  return (
    <div>
      <h2>Delivery Challans</h2>

      <select value={filter} onChange={(e) => setFilter(e.target.value)}>
        <option>ACTIVE</option>
        <option>DELIVERED</option>
        <option>CANCELLED</option>
        <option>ALL</option>
      </select>

      <br /><br />

      <table border="1" width="100%">
        <thead>
          <tr>
            <th>ID</th>
            <th>Challan No</th>
            <th>Date</th>
            <th>Customer</th>
            <th>Total</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          {filtered.map((c) => (
            <tr key={c.id}>
              <td>{c.id}</td>
              <td>{c.challanNumber}</td>
              <td>{c.challanDate}</td>
              <td>{c.customerName}</td>
              <td>₹{c.grandTotal}</td>
              <td>{c.status}</td>

              <td>
                <button onClick={() => onEdit(c)}>Edit</button>

                <button onClick={() => window.open(getDeliveryChallanPdf(c.id))}>
                  Print
                </button>

                <button onClick={() => cancelDeliveryChallan(c.id)}>
                  Cancel
                </button>

                {c.status === "DELIVERED" && (
                  <button onClick={() => handleViewInvoice(c.id)}>
                    View Invoice
                  </button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}